SECRET_MANAGER_MASTER_KEY=replace-with-a-long-random-string

# Bootstrap tokens. MUST NOT CONTAIN A '.' — the dot is reserved as the separator
# in the `<name>.<secret>` token wire format, so a dotted value is parsed as a
# named token and can never authenticate. The server hard-exits at boot with
# `FATAL: SECRET_MANAGER_ADMIN_TOKEN contains a '.'` rather than come up bricked.
# Generate a safe (hex, dotless) value with: openssl rand -hex 32
SECRET_MANAGER_ADMIN_TOKEN=replace-with-write-token
SECRET_MANAGER_READ_TOKEN=replace-with-read-token
SECRET_MANAGER_DB_PATH=data/secrets.db
SECRET_MANAGER_RATE_LIMIT_PER_MINUTE=120
SECRET_MANAGER_HOST=0.0.0.0
SECRET_MANAGER_PORT=8000

# Comma-separated IPs of trusted reverse proxies for X-Forwarded-For header
# Only requests from these IPs will have X-Forwarded-For trusted for rate limiting
SECRET_MANAGER_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Rate limit for the public-facing GET /api/secrets/:folder/:key endpoint (per IP per minute)
SECRET_MANAGER_PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Audit log retention in days — logs older than this are pruned on startup and daily
SECRET_MANAGER_AUDIT_LOG_RETENTION_DAYS=90
