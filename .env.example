SECRET_MANAGER_MASTER_KEY=replace-with-a-long-random-string

# Bootstrap tokens. MUST NOT CONTAIN A '.' — the dot is reserved as the separator
# in the `<name>.<secret>` token wire format, so a dotted value is parsed as a
# named token and can never authenticate. The server hard-exits at boot with
# `FATAL: SECRET_MANAGER_ADMIN_TOKEN contains a '.'` rather than come up bricked.
# Generate a safe (hex, dotless) value with: openssl rand -hex 32
SECRET_MANAGER_ADMIN_TOKEN=replace-with-write-token
SECRET_MANAGER_READ_TOKEN=replace-with-read-token
SECRET_MANAGER_DB_PATH=data/secrets.db
SECRET_MANAGER_RATE_LIMIT_PER_MINUTE=120
SECRET_MANAGER_HOST=0.0.0.0
SECRET_MANAGER_PORT=8000

# Comma-separated IPs of trusted reverse proxies for X-Forwarded-For header
# Only requests from these IPs will have X-Forwarded-For trusted for rate limiting
SECRET_MANAGER_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Rate limit for the public-facing GET /api/secrets/:folder/:key endpoint (per IP per minute)
SECRET_MANAGER_PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Audit log retention in days — logs older than this are pruned on startup and daily
SECRET_MANAGER_AUDIT_LOG_RETENTION_DAYS=90

# ── In-process vault backup (RUNBOOK §3) ──────────────────────────────────────
# Unset = feature off. On the VPS: /app/backups (bind mount ./backups).
# Must not be inside frontend/, server/ or data/ (the feature then stays off).
# SECRET_MANAGER_BACKUP_DIR=/app/backups
# Daily slot, HH:MM UTC (default 22:30 = 04:00 IST). Invalid → default + paged.
# SECRET_MANAGER_BACKUP_UTC_TIME=22:30
# Local copies kept, in days (default 14).
# SECRET_MANAGER_BACKUP_KEEP_DAYS=14
#
# Off-site copy (production only). Setting ANY of recipient / repo / token /
# push URL requests it, and then all four are required.
# age PUBLIC recipient(s), comma-separated (age1… or age1pq1…). Never put the
# private key (AGE-SECRET-KEY-…) anywhere on the VPS: off-site is refused.
# SECRET_MANAGER_BACKUP_AGE_RECIPIENT=
# SECRET_MANAGER_BACKUP_GITHUB_REPO=owner/vault-backups
# SECRET_MANAGER_BACKUP_GITHUB_RELEASE_TAG=daily
# SECRET: fine-grained PAT, this one repo only, Contents read/write.
# SECRET_MANAGER_BACKUP_GITHUB_TOKEN=
# SECRET_MANAGER_BACKUP_REMOTE_KEEP_DAILY=30
# SECRET_MANAGER_BACKUP_REMOTE_KEEP_MONTHLY=12
# SECRET (capability): Uptime Kuma push URL, https only.
# SECRET_MANAGER_BACKUP_PUSH_URL=
# DEV/TEST ONLY: off-site and Kuma run only when NODE_ENV=production (set by the
# image). =1 lifts that gate on a non-production box; never set it on a box that
# holds the production repo, PAT or push URL.
# SECRET_MANAGER_BACKUP_ALLOW_NONPROD=
